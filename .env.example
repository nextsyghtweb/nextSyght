# ---------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your values.
#   cp .env.example .env
# Then restart `npm run dev`.
#
# On Vercel / Netlify, add these same three names as Environment
# Variables in the project settings, then redeploy.
# ---------------------------------------------------------------

# 1) CONTACT FORM – Formspree
#    Create a form at https://formspree.io, then copy the ID from its URL
#    (https://formspree.io/f/xxxxxxxx  ->  the "xxxxxxxx" part).
VITE_FORMSPREE_FORM_ID=xrpqpzpz

# 2) BACKEND – Supabase (Project Settings -> API)
#    "Project URL" and the "anon public" key. The anon key is SAFE to expose
#    in the browser because Row Level Security (see supabase/schema.sql)
#    blocks anyone but you from editing. NEVER put the "service_role" key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
