{
  // Cloudflare Workers deployment config (static site + single-page-app routing).
  // "name" must match the Worker name in your Cloudflare dashboard.
  "name": "nextsyghtweb",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Folder produced by `npm run build`
    "directory": "./dist",
    // Send unknown paths (like /admin) to index.html so React Router can handle them
    "not_found_handling": "single-page-application"
  }
}
