{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextsyght",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
